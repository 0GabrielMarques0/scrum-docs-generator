# Server
PORT=3001
NODE_ENV=development

# MySQL - defaults match docker-compose.yml (npm run db:up)
# DATABASE_URL=mysql://user:password@host:3306/database  (alternative to the DB_* variables)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=specai
DB_PASSWORD=specai_dev
DB_NAME=scrum_docs

# AI provider: 'gemini' (Google, free tier) or 'anthropic' (Claude API, paid)
AI_PROVIDER=gemini

# Gemini - free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Claude (only when AI_PROVIDER=anthropic) - https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# JWT secret - REQUIRED in production, min. 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend URL(s) - CORS allow-list and links in emails. REQUIRED in production.
# Comma-separated for more than one origin; the first one is used in emails.
FRONTEND_URL=http://localhost:3000

# Email (Resend) - optional; without it, reset links are only logged in development
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=no-reply@seudominio.com
